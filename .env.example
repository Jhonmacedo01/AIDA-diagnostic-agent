cat > .env.example << 'EOF'
# ======================================
# AIDA - Variáveis de ambiente (exemplo)
# Escolha APENAS UMA chave de API
# ======================================

# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# Modelo opcional (sobrescrever padrão)
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat

# Porta do servidor (opcional)
PORT=3000

# CORS (opcional, separar por vírgula, usar * apenas em dev)
# CORS_ORIGIN=http://localhost:3000,https://meuapp.onrender.com

# Timeout das chamadas à IA em ms (opcional)
# AI_REQUEST_TIMEOUT_MS=25000
EOF